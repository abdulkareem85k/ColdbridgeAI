# Application Environment: development, testing, production
APP_ENV=development

# Database connection: SQLite by default; use PostgreSQL in production
DATABASE_URL=sqlite:///./coldbridge.db

# Authentication / JWT
JWT_SECRET=coldbridge_super_secret_jwt_key_development_only_change_in_production_32chars
ACCESS_TOKEN_EXPIRE_MINUTES=60
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Frontend origin for CORS
FRONTEND_ORIGIN=http://127.0.0.1:5500

# OpenStreetMap & OSRM (100% Free, No Google Cloud Key Required)
OSRM_ROUTING_URL=https://router.project-osrm.org
OSM_USER_AGENT=ColdBridgeAI-Avishkar/1.0

# Routing and Cache configuration
ROUTE_CACHE_MINUTES=60
MAX_ROUTE_CALLS_PER_REQUEST=8
MAX_ROUTE_CALLS_PER_DAY=200
LOCATION_FRESHNESS_MINUTES=60
